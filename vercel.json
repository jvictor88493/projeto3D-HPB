{
  "functions": {
    "api/page.js": {
      "includeFiles": "private/**"
    },
    "api/full.js": {
      "includeFiles": "private/**"
    },
    "api/rec.js": {
      "includeFiles": "private/rec.html"
    },
    "api/repimg.js": {
      "includeFiles": "private/rep_img/**"
    }
  },
  "rewrites": [
    {
      "source": "/",
      "destination": "/api/page"
    },
    {
      "source": "/login",
      "destination": "/login.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    }
  ]
}